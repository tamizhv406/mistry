# Copy to .env.local for development, or .env.production.local for a release build made on
# this computer. For the website, set the same names in Vercel: Project → Settings →
# Environment Variables, then redeploy. Never commit a file with real values.
#
# Every VITE_ value is compiled into the app and can be read by anyone who opens the site.
# Only public values belong here: never a service-role key, a database password or an AI key.

# Cloud backup (optional). Without these two the app keeps all records on the device only.
VITE_SUPABASE_URL=
# The public anon / publishable key only.
VITE_SUPABASE_ANON_KEY=

# AI Design through a Supabase Edge Function (optional). The AI key itself is a server-side
# secret of that function. Without this the built-in layout rules are used.
VITE_AI_DESIGN_FUNCTION=

# Initial administrator (optional). A production build creates this account only when
# VITE_INITIAL_ADMIN_HASH is set: the SHA-256 hex digest of a first-login password, which the
# administrator must replace at first sign-in. The digest is public once deployed, so use a
# long random password for it and never one that is used anywhere else.
VITE_INITIAL_ADMIN_EMAIL=
VITE_INITIAL_ADMIN_USERNAME=
VITE_INITIAL_ADMIN_HASH=

# "true" keeps the demo accounts in a production build. Their password is public.
VITE_ENABLE_DEMO_LOGIN=

# SMS gateway for password-recovery codes (optional). Without it no code is sent.
VITE_SMS_GATEWAY_URL=
